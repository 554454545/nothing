{
  "name": "nextjs-minimal",
  "private": true,
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:bg": "tmux has-session -t nextjs-dev 2>/dev/null || tmux new-session -d -s nextjs-dev 'bash scripts/dev.sh'",
    "dev:stop": "tmux kill-session -t nextjs-dev 2>/dev/null || true",
    "build": "next build",
    "start": "bash scripts/start.sh",
    "cf:d1:migrate": "wrangler d1 migrations apply nextjs-mvp-db --local",
    "cf:d1:migrate:remote": "wrangler d1 migrations apply nextjs-mvp-db --remote",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "start:vinext": "vite preview",
    "deploy:vinext": "vinext-cloudflare deploy"
  },
  "dependencies": {
    "@vinext/cloudflare": "^1.3.3",
    "next": "16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-server-dom-webpack": "^19.3.1",
    "vinext": "^1.4.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.v.12",
    "@next/swc-wasm-nodejs": "^16.4.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitejs/plugin-rsc": "^0.5.39",
    "cf": "^1.0.0-beta.28",
    "typescript": "^5.0.0",
    "vite": "^8.3.0",
    "wrangler": "^4.158.0"
  },
  "type": "module"
}
